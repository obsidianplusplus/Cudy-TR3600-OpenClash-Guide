# Reference fragment only; do not replace your complete network configuration.
# 仅作对照，不要直接覆盖完整网络配置。
config device
        option name 'br-lan'
        option type 'bridge'
        list ports 'eth1'

config interface 'lan'
        option device 'br-lan'
        option proto 'static'
        list ipaddr '192.168.10.1/24'
        option ip6assign '60'

config interface 'wan'
        option device 'eth0'
        option proto 'dhcp'

config interface 'wan6'
        option device 'eth0'
        option proto 'dhcpv6'
